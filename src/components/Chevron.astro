---
interface Props { dir?: 'left' | 'right' }
const { dir = 'right' } = Astro.props;
const d = dir === 'left' ? 'M10 3.5 5.5 8l4.5 4.5' : 'M6 3.5 10.5 8 6 12.5';
---
<svg class="chev" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
  <path d={d} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
</svg>
